NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/tecnowallet
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL=30d
JWT_REFRESH_TTL=3650d
CORS_ORIGINS=http://127.0.0.1:8081,http://localhost:8081,http://localhost:19006
LOG_LEVEL=info
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_BRANCH_KEY=
EXPO_PUBLIC_BRANCH_DOMAIN=tecnowallet.app.link
EXPO_PUBLIC_BRANCH_ALTERNATE_DOMAIN=tecnowallet-alternate.app.link

# Optional provider credentials. Leave blank to use local adapters.
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_COMPLEX=gpt-4o
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT_ID=plus
REVENUECAT_BUSINESS_ENTITLEMENT_ID=business
PLUS_ENFORCEMENT_ENABLED=true
RUN_FREEMIUM_MIGRATIONS=true
BRANCH_SECRET=
BRANCH_DEFAULT_DOMAIN=tecnowallet.app.link
# Bootstrap one-shot: yarn workspace api bootstrap:admin (never commit the password)
ADMIN_BOOTSTRAP_EMAIL=mercancias.visbal@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=
PLAID_CLIENT_ID=
PLAID_SECRET=
# Belvo open banking (sandbox: https://sandbox.belvo.com — production: https://api.belvo.com)
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_API_URL=https://sandbox.belvo.com
FINTOC_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Firebase / iOS Push (APNs) — set real values in .env / Render, not here.
FIREBASE_PROJECT_ID=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.tecnowallet.mobile
APNS_KEY_PATH=
APNS_KEY_BASE64=
APNS_PRODUCTION=false

# Render deploy hook (set real URL only in .env / Render secrets, never commit the key)
RENDER_DEPLOY_HOOK=

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact@tecnowallet.app
BREVO_SENDER_NAME=TecnoWallet
RECAUDO_INVITE_BASE_URL=http://localhost:8081/invite

# Unit Sandbox (CUSTOM build path) — tokens only in private .env / Render
# Token must include counterparties-write (and accounts-write) or bank linking returns 403.
UNIT_API_URL=https://api.s.unit.sh
UNIT_API_TOKEN=
UNIT_WEBHOOK_SECRET=
UNIT_WALLET_TERMS=walletDefault
UNIT_DEPOSIT_PRODUCT=checking

# Bridge sandbox (https://api.sandbox.bridge.xyz) — keys only in private .env / Render
# Sandbox keys are prefixed sk-test. Production: https://api.bridge.xyz + sk-live.
BRIDGE_API_URL=https://api.sandbox.bridge.xyz
BRIDGE_API_KEY=
BRIDGE_WEBHOOK_SECRET=

# Mercado Pago (sandbox keys only in private .env / Render — never commit)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_NOTIFICATION_URL=https://tecnowallet.onrender.com/api/v1/webhooks/mercadopago

# Google Sign-In (Web OAuth client ID is public; secret only in private .env / Render)
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_SECRET=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_APP_WEB_URL=https://tecnowallet.app
