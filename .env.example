NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/tecnowallet
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL=30d
JWT_REFRESH_TTL=3650d
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
LOG_LEVEL=info
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Optional provider credentials. Leave blank to use local adapters.
OPENAI_API_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
FINTOC_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Firebase / iOS Push (APNs) — set real values in .env / Render, not here.
FIREBASE_PROJECT_ID=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.tecnowallet.mobile
APNS_KEY_PATH=
APNS_KEY_BASE64=
APNS_PRODUCTION=false

# Render deploy hook (set real URL only in .env / Render secrets, never commit the key)
RENDER_DEPLOY_HOOK=

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact@tecnowallet.app
BREVO_SENDER_NAME=TecnoWallet
RECAUDO_INVITE_BASE_URL=http://localhost:8081/invite

# Unit Sandbox (CUSTOM build path) — tokens only in private .env / Render
# Token must include counterparties-write (and accounts-write) or bank linking returns 403.
UNIT_API_URL=https://api.s.unit.sh
UNIT_API_TOKEN=
UNIT_WEBHOOK_SECRET=
UNIT_WALLET_TERMS=walletDefault
UNIT_DEPOSIT_PRODUCT=checking

# Google Sign-In (Web OAuth client ID is public; secret only in private .env / Render)
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_SECRET=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
