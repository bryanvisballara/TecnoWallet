NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/tecnowallet
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL=30d
JWT_REFRESH_TTL=3650d
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=100
LOG_LEVEL=info

# Firebase / iOS Push (APNs) — set real values in .env / Render, not here.
FIREBASE_PROJECT_ID=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.tecnowallet.mobile
APNS_KEY_PATH=
APNS_KEY_BASE64=
APNS_PRODUCTION=false

# Render deploy hook (set real URL only in .env, never commit the key)
RENDER_DEPLOY_HOOK=

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact@tecnowallet.app
BREVO_SENDER_NAME=TecnoWallet
RECAUDO_INVITE_BASE_URL=http://localhost:8081/invite

# Unit Sandbox (never commit real tokens)
UNIT_API_URL=https://api.s.unit.sh
UNIT_API_TOKEN=
UNIT_WEBHOOK_SECRET=
UNIT_WALLET_TERMS=walletDefault

# Google Sign-In
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_SECRET=
