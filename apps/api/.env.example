NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/tecnowallet
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=100
LOG_LEVEL=info

# Firebase / iOS Push (APNs) — set real values in .env / Render, not here.
FIREBASE_PROJECT_ID=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.tecnowallet.mobile
APNS_KEY_PATH=
APNS_KEY_BASE64=
APNS_PRODUCTION=false
