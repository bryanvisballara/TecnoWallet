{
  "expo": {
    "name": "TecnoWallet",
    "slug": "tecnowallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "tecnowallet",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "bundleIdentifier": "com.tecnowallet.mobile",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "CFBundleAllowMixedLocalizations": true
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tecnowallet.mobile",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#081430",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png",
      "backgroundColor": "#FFFFFF",
      "themeColor": "#FFFFFF"
    },
    "plugins": [
      "./plugins/with-app-delegate-no-rctbridge.js",
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "defaultChannel": "activity",
          "sounds": [
            "./assets/sounds/ingreso.wav",
            "./assets/sounds/gasto.wav",
            "./assets/sounds/calendario.wav",
            "./assets/sounds/sobres.wav"
          ]
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Permite que TecnoWallet use Face ID para proteger tus finanzas."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite que TecnoWallet use Face ID para proteger tus finanzas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TecnoWallet necesita acceso a tus fotos para adjuntar recibos.",
          "cameraPermission": "TecnoWallet necesita la cámara para fotografiar recibos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-screen.png",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
